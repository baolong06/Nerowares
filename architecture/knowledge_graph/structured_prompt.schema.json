{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuroprompt.local/schemas/structured-prompt-v1.json",
  "title": "NeuroPrompt Structured Prompt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "modality",
    "intent",
    "subject",
    "attributes",
    "constraints",
    "kg"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "modality": {
      "type": "string",
      "enum": ["image", "text", "music", "video", "3d"]
    },
    "intent": {"$ref": "#/$defs/groundedValue"},
    "subject": {"$ref": "#/$defs/groundedConcept"},
    "attributes": {
      "type": "array",
      "items": {"$ref": "#/$defs/attribute"}
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "forbidden"],
      "properties": {
        "required": {"type": "array", "items": {"type": "string"}},
        "forbidden": {"type": "array", "items": {"type": "string"}}
      }
    },
    "kg": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ontology_version", "subgraph_id"],
      "properties": {
        "ontology_version": {"type": "string", "minLength": 1},
        "subgraph_id": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "groundedValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "confidence", "provenance"],
      "properties": {
        "value": {"type": "string", "minLength": 1},
        "confidence": {"$ref": "#/$defs/confidence"},
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    },
    "groundedConcept": {
      "type": "object",
      "additionalProperties": false,
      "required": ["concept_id", "label", "confidence", "provenance"],
      "properties": {
        "concept_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*:[A-Za-z0-9_-]+$"},
        "label": {"type": "string", "minLength": 1},
        "confidence": {"$ref": "#/$defs/confidence"},
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    },
    "attribute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["concept_id", "operator", "confidence", "status", "provenance"],
      "properties": {
        "concept_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*:[A-Za-z0-9_-]+$"},
        "operator": {
          "type": "string",
          "enum": ["set", "increase", "decrease", "preserve", "avoid"]
        },
        "value": {"type": ["string", "number", "boolean", "null"]},
        "confidence": {"$ref": "#/$defs/confidence"},
        "status": {
          "type": "string",
          "enum": ["accepted", "suggested", "rejected", "unknown"]
        },
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    }
  }
}
